#!/bin/sh
# Verwaltung einer SchauFUCHS-Installation (angelegt von install.sh; Linux: /opt/schaufuchs, Mac: ~/SchauFUCHS).
# Aufruf: schaufuchs hilfe
set -eu
ZIEL="$(dirname "$(readlink -f "$0")")"
cd "$ZIEL"
KONTO="eddyreddington"

fett() { printf '\033[1m%s\033[0m\n' "$*"; }
fehler() { printf '\033[31mFehler:\033[0m %s\n' "$*" >&2; exit 1; }
wert() { sed -n "s/^$1=//p" .env | tail -n 1 | sed 's/^"//; s/"$//'; }
setze() {
  # Ohne „sed -i“ (unterscheidet sich zwischen Linux und Mac); „cat >“ behält die Rechte der Datei.
  if grep -q "^$1=" .env; then sed "s#^$1=.*#$1=$2#" .env > .env.neu && cat .env.neu > .env && rm -f .env.neu; else printf '%s=%s\n' "$1" "$2" >> .env; fi
}
# Linux: als root (Docker und /opt gehören root). Mac: als Benutzer (Docker Desktop/OrbStack).
if [ "$(uname -s)" = "Linux" ]; then
  [ "$(id -u)" = "0" ] || fehler "Bitte mit sudo ausführen: sudo schaufuchs $*"
  AUFRUF="sudo schaufuchs"
else
  AUFRUF="schaufuchs"
fi
[ -f .env ] || fehler "Keine Installation in $ZIEL gefunden."

gesund() {
  for _ in $(seq 1 "${1:-60}"); do
    docker compose exec -T app bun -e "fetch('http://localhost:8787/api/gesund').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" < /dev/null > /dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

# Privaten Sicherungsschlüssel abfragen und nur im Arbeitsspeicher ablegen (/dev/shm); gibt den Pfad aus.
schluessel_abfragen() {
  # Im Arbeitsspeicher (/dev/shm), nie auf der Platte. SCHAUFUCHS_TMP nur für Probeläufe in Containern.
  # Ohne /dev/shm (Mac): im privaten temporären Ordner des Benutzers, nach Gebrauch gelöscht.
  [ -d /dev/shm ] && tmp=/dev/shm || tmp="${TMPDIR:-/tmp}"
  datei=$(mktemp "${SCHAUFUCHS_TMP:-$tmp}/schaufuchs-schluessel.XXXXXX")
  # Ohne Rückfrage (Automatisierung): SCHAUFUCHS_SCHLUESSEL=/pfad/zur/datei mit dem Schlüssel.
  if [ -n "${SCHAUFUCHS_SCHLUESSEL:-}" ]; then
    grep '^AGE-SECRET-KEY-' "$SCHAUFUCHS_SCHLUESSEL" > "$datei" || { rm -f "$datei"; fehler "Kein Sicherungsschlüssel in $SCHAUFUCHS_SCHLUESSEL."; }
    printf '%s' "$datei"
    return
  fi
  printf 'Sicherungsschlüssel vom Notfallblatt (beginnt mit AGE-SECRET-KEY-): ' > /dev/tty
  stty -echo < /dev/tty 2> /dev/null || true
  read -r schluessel < /dev/tty
  stty echo < /dev/tty 2> /dev/null || true
  echo > /dev/tty
  case "$schluessel" in AGE-SECRET-KEY-*) ;; *) rm -f "$datei"; fehler "Das ist kein Sicherungsschlüssel." ;; esac
  printf '%s\n' "$schluessel" > "$datei"
  printf '%s' "$datei"
}

# Absicherung des Servers abfragen (Anleitung: docs/installation.md, „Server absichern“). Gibt nur Hinweise, ändert
# nichts. Steht hier und nicht in einer eigenen Datei, weil ein Update von 1.2.0 nur die bekannten Dateien holt.
absicherung_pruefen() {
  hinweise=0
  gut() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
  hinweis() { printf '  \033[33m!\033[0m %s\n' "$*"; hinweise=$((hinweise + 1)); }
  fett "SSH"
  if command -v sshd > /dev/null 2>&1 || [ -x /usr/sbin/sshd ]; then
    # Fehlermeldungen mitnehmen: ssh_wert liest nur die Einstellungszeilen, der Hinweis unten nennt sonst den Grund.
    ssh_werte=$(PATH="$PATH:/usr/sbin" sshd -T 2>&1 || true)
    ssh_wert() { printf '%s\n' "$ssh_werte" | awk -v n="$1" '$1 == n { print $2; exit }'; }
    case "$(ssh_wert permitrootlogin)" in
      no) gut "Anmeldung als root abgeschaltet (PermitRootLogin no)" ;;
      "") hinweis "SSH-Einstellungen nicht lesbar (sshd -T: $(printf '%s\n' "$ssh_werte" | head -n 1)) – bitte von Hand prüfen" ;;
      *) hinweis "Anmeldung als root ist erlaubt ($(ssh_wert permitrootlogin)) – PermitRootLogin no setzen" ;;
    esac
    case "$(ssh_wert passwordauthentication)" in
      no) gut "Anmeldung nur mit Schlüssel (PasswordAuthentication no)" ;;
      "") ;;
      *) hinweis "Anmeldung mit Passwort ist erlaubt – PasswordAuthentication no setzen (vorher Schlüssel prüfen)" ;;
    esac
    [ "$(ssh_wert kbdinteractiveauthentication)" != "yes" ] || hinweis "KbdInteractiveAuthentication yes erlaubt Passwörter auf anderem Weg – auf no setzen"
  else
    gut "Kein SSH-Server installiert"
  fi
  fett "Firewall"
  if command -v ufw > /dev/null 2>&1; then
    ufw_status=$(ufw status 2> /dev/null || true)
    if printf '%s' "$ufw_status" | grep -q "Status: active"; then
      gut "ufw ist eingeschaltet"
      for port in 22 80 443; do
        muster="^$port(/tcp)?[[:space:]]"
        [ "$port" != 22 ] || muster="^(22(/tcp)?|OpenSSH)[[:space:]]"
        printf '%s\n' "$ufw_status" | grep -Eq "$muster.*(ALLOW|LIMIT)" || hinweis "Port $port ist in ufw nicht freigegeben"
      done
      andere=$(printf '%s\n' "$ufw_status" | awk '/ALLOW|LIMIT/ { split($1, p, "/"); if (p[1] != "22" && p[1] != "80" && p[1] != "443" && p[1] != "OpenSSH") print $1 }' | sort -u | tr '\n' ' ')
      [ -z "$andere" ] || hinweis "Weitere offene Ports in ufw: $andere– nötig?"
    else
      hinweis "ufw ist installiert, aber nicht eingeschaltet"
    fi
  else
    hinweis "Keine Firewall (ufw) installiert – außer der Anbieter filtert davor (Firewall im Kundenbereich)"
  fi
  fett "Updates"
  if dpkg -s unattended-upgrades > /dev/null 2>&1; then
    if apt-config dump 2> /dev/null | grep -q '^APT::Periodic::Unattended-Upgrade "1"'; then
      gut "Sicherheitsupdates werden automatisch eingespielt (unattended-upgrades)"
    else
      hinweis "unattended-upgrades ist installiert, aber nicht eingeschaltet (dpkg-reconfigure -plow unattended-upgrades)"
    fi
  else
    hinweis "Keine automatischen Sicherheitsupdates – unattended-upgrades installieren"
  fi
  if [ -f /var/run/reboot-required ]; then hinweis "Neustart nötig, damit Updates wirken (nicht am Schautag): sudo reboot"; else gut "Kein Neustart ausstehend"; fi
  if command -v fail2ban-client > /dev/null 2>&1; then
    if fail2ban-client status sshd > /dev/null 2>&1; then gut "fail2ban schützt SSH"; else hinweis "fail2ban ist installiert, der Schutz für SSH läuft aber nicht"; fi
  fi
  fett "SchauFUCHS"
  if [ -z "$(find backups -maxdepth 1 -name 'schau-*.dump*' -mmin -1560 2> /dev/null | head -n 1)" ]; then
    hinweis "Keine Sicherung aus den letzten 26 Stunden – $AUFRUF logs"
  else
    gut "Sicherung aus den letzten 26 Stunden vorhanden"
  fi
  frei=$(df -Pk "$ZIEL" | awk 'NR==2 { print int($4 / 1048576) }')
  if [ "$frei" -lt 5 ]; then hinweis "Nur noch $frei GB frei"; else gut "$frei GB frei"; fi
  blaetter=$(ls /root/schaufuchs-notfallblatt.txt /home/*/schaufuchs-notfallblatt.txt 2> /dev/null | tr '\n' ' ' | sed 's/ $//' || true)
  [ -z "$blaetter" ] || hinweis "Notfallblatt liegt noch auf dem Server ($blaetter) – ablegen, dann löschen"
  echo
  if [ "$hinweise" = 0 ]; then fett "Keine Hinweise."; else fett "$hinweise Hinweis(e). Anleitung: docs/installation.md, Abschnitt „Server absichern“."; fi
}

neueste_version() {
  curl -fsSL "https://api.github.com/repos/$KONTO/schaufuchs/releases/latest" 2> /dev/null | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -n 1
}

befehl="${1:-hilfe}"
[ $# -gt 0 ] && shift
case "$befehl" in
  status)
    fett "SchauFUCHS $(wert SCHAUFUCHS_VERSION) – $(wert PUBLIC_URL)"
    docker compose ps --format 'table {{.Service}}\t{{.Status}}'
    if gesund 1; then echo "Anwendung: läuft"; else echo "Anwendung: antwortet nicht ($AUFRUF logs)"; fi
    echo "Letzte Sicherung: $(ls -t backups/*.dump* 2> /dev/null | head -n 1 || echo keine)"
    df -h "$ZIEL" | awk 'NR==2{print "Freier Platz: " $4}'
    ;;

  update)
    alt=$(wert SCHAUFUCHS_VERSION)
    neu="${1:-$(neueste_version)}"
    [ -n "$neu" ] || fehler "Neueste Version nicht gefunden. Bitte angeben, z. B.: schaufuchs update 1.3.0"
    if [ "$neu" = "$alt" ]; then echo "SchauFUCHS $alt ist aktuell."; exit 0; fi
    fett "Update von $alt auf $neu"
    echo "1. Sicherung des jetzigen Stands …"
    docker compose run --rm --no-deps backup einmal vor-update
    echo "2. Neue Dateien und Programme laden …"
    # SCHAUFUCHS_QUELLE: lokales Repo statt GitHub (nur für Probeläufe).
    quelle="${SCHAUFUCHS_QUELLE:-https://raw.githubusercontent.com/$KONTO/schaufuchs/v$neu}"
    hole() { case "$quelle" in http*) curl -fsSL "$quelle/$1" -o "$2" ;; *) cp "$quelle/$1" "$2" ;; esac || fehler "Konnte $1 nicht laden – nichts verändert."; }
    for d in docker-compose.yml Caddyfile schaufuchs; do hole "deploy/$d" "$d.neu"; done
    hole scripts/wiederherstellen.sh scripts/wiederherstellen.sh.neu
    case "$(wert SCHAUFUCHS_IMAGE)" in
      */*) SCHAUFUCHS_VERSION="$neu" docker compose -f docker-compose.yml.neu pull -q || fehler "Programme $neu nicht gefunden – nichts verändert." ;;
    esac
    for d in docker-compose.yml Caddyfile schaufuchs; do mv "$d.neu" "$d"; done
    mv scripts/wiederherstellen.sh.neu scripts/wiederherstellen.sh
    chmod 755 schaufuchs
    setze SCHAUFUCHS_VORHER "$alt"
    setze SCHAUFUCHS_VERSION "$neu"
    echo "3. Starten …"
    docker compose up -d
    if gesund 90; then
      fett "SchauFUCHS $neu läuft."
    else
      echo "SchauFUCHS $neu startet nicht. Zurück auf $alt mit:  $AUFRUF zuruecknehmen" >&2
      exit 1
    fi
    ;;

  zuruecknehmen)
    vorher=$(wert SCHAUFUCHS_VORHER)
    [ -n "$vorher" ] || fehler "Keine vorherige Version bekannt."
    sicherung=$(ls -t backups/*-vor-update.dump* 2> /dev/null | head -n 1 || true)
    [ -n "$sicherung" ] || fehler "Keine Sicherung vor dem Update gefunden."
    echo "Zurück auf Version $vorher mit der Sicherung $sicherung."
    echo "Alles, was seit dem Update eingegeben wurde, geht dabei verloren."
    schluessel=$(schluessel_abfragen)
    trap 'rm -f "$schluessel"' EXIT
    setze SCHAUFUCHS_VERSION "$vorher"
    case "$(wert SCHAUFUCHS_IMAGE)" in */*) docker compose pull -q app backup || true ;; esac
    sh scripts/wiederherstellen.sh --schluessel "$schluessel" "$sicherung"
    ;;

  sichern)
    docker compose run --rm --no-deps backup einmal manuell
    ls -t backups/*.dump* | head -n 1
    ;;

  sicherungen)
    ls -lht backups/ | head -n "${1:-20}"
    ;;

  wiederherstellen)
    datei="${1:-}"
    [ -n "$datei" ] || fehler "Bitte die Sicherung angeben, z. B.: schaufuchs wiederherstellen backups/schau-2026-11-15-1200.dump.age  (Liste: schaufuchs sicherungen)"
    case "$datei" in /*) ;; backups/*) datei="$ZIEL/$datei" ;; *) datei="$ZIEL/backups/$datei" ;; esac
    schluessel=$(schluessel_abfragen)
    trap 'rm -f "$schluessel"' EXIT
    sh scripts/wiederherstellen.sh --schluessel "$schluessel" "$datei"
    ;;

  einrichten)
    # Verein und ersten Administrator anlegen, Link „Passwort setzen“ per Mail (Entscheidung 026). Ab Version 1.12.0.
    docker compose exec -T app test -f apps/server/src/einrichten.ts || fehler "Das braucht SchauFUCHS ab 1.12.0 – zuerst: $AUFRUF update"
    docker compose exec -T -w /app/apps/server app bun src/einrichten.ts "$@"
    ;;

  einstellungen)
    "${EDITOR:-nano}" .env
    docker compose up -d
    ;;

  neustart)
    docker compose up -d --force-recreate
    gesund 90 && echo "Läuft." || fehler "Startet nicht – $AUFRUF logs"
    ;;

  logs)
    docker compose logs --tail "${1:-200}" app caddy backup
    ;;

  pruefen)
    [ "$(uname -s)" = "Linux" ] && [ -f /etc/debian_version ] || fehler "„pruefen“ gibt es nur auf Linux-Servern mit Debian oder Ubuntu."
    absicherung_pruefen
    ;;

  hilfe|*)
    cat << HILFE
SchauFUCHS verwalten (Linux: immer mit sudo):

  schaufuchs status              Läuft alles? Version, letzte Sicherung, freier Platz
  schaufuchs einrichten --verein V --name N --email E [--link-zeigen]
                                 Verein und ersten Administrator anlegen; Link „Passwort setzen“ per Mail
                                 (mit --link-zeigen hier im Terminal) – statt der Einrichtung im Browser
  schaufuchs update [VERSION]    Auf die neueste (oder angegebene) Version aktualisieren – sichert vorher
  schaufuchs zuruecknehmen       Letztes Update zurücknehmen (braucht den Sicherungsschlüssel)
  schaufuchs sichern             Jetzt eine Sicherung anlegen
  schaufuchs sicherungen         Vorhandene Sicherungen anzeigen
  schaufuchs wiederherstellen D  Sicherung D zurückspielen (braucht den Sicherungsschlüssel)
  schaufuchs einstellungen       Einstellungen bearbeiten (z. B. Mailversand), danach Neustart
  schaufuchs neustart            Alles neu starten
  schaufuchs logs [N]            Letzte N Meldungen von Anwendung, HTTPS und Sicherung (Vorgabe 200)
  schaufuchs pruefen             Absicherung des Servers prüfen (SSH, Firewall, Updates) – ändert nichts

Installation: $ZIEL · Sicherungen: $ZIEL/backups (bitte auch außer Haus kopieren)
HILFE
    ;;
esac
