# Kopieren nach .env und anpassen. Die .env gehört nicht ins Git.

# Öffentliche Adresse der Anwendung (für Links in E-Mails an Aussteller).
# Beginnt sie mit https://, werden Anmelde-Cookies nur verschlüsselt übertragen.
PUBLIC_URL=https://schau.example.de

# Passwort der Datenbank (nur docker-compose). Nur Buchstaben und Ziffern – Zeichen wie # / ? % zerlegen die
# Verbindungsadresse. Erzeugen z. B. mit:  openssl rand -hex 32
POSTGRES_PASSWORD=bitte-mit-openssl-rand-hex-32-erzeugen

# Name in Kopfzeile und Anmeldung
APP_NAME=SchauFUCHS

# E-Mail-Versand (leer = Mails bleiben im Postausgang der Datenbank)
# Format: smtp://benutzer:passwort@server:587 (oder smtps://…:465). Sonderzeichen in Benutzer und Passwort
# URL-kodieren: @ → %40, # → %23, / → %2F, ? → %3F, % → %25, : → %3A. Ist die Adresse ungültig, startet der Server
# ohne Mailversand und zeigt den Fehler unter „Verein und Datenschutz › Postausgang“.
SMTP_URL=
MAIL_FROM=Ausstellungsleitung <ausstellung@example.de>

# Schutz der Ersteinrichtung (wer zuerst einrichtet, wird Administrator). Für öffentlich erreichbare
# Installationen einen langen Zufallswert setzen und bei der Einrichtung eingeben; danach wird er nicht mehr gebraucht.
EINRICHTUNG_CODE=

# Hinter einem eigenen Reverse-Proxy (Caddy, nginx – der übliche Betrieb mit HTTPS) auf 1 setzen. Sonst sehen
# die Bremsen gegen Missbrauch alle Anfragen als eine einzige Adresse. Der Server warnt beim Start, wenn das so aussieht.
TRUST_PROXY=0

# Administratoren verwalten erst nach eingerichteter Zwei-Faktor-Anmeldung (Standard). Nur im Notfall auf 0 setzen –
# wer 2FA eingerichtet hat, braucht sie beim Anmelden weiter (siehe docs/betrieb.md, Abschnitt Zwei-Faktor).
# ZWEI_FAKTOR_PFLICHT=1

# Port nach außen (docker-compose). Standard nur auf diesem Rechner (127.0.0.1) – von außen über den Reverse-Proxy.
# Soll die Anwendung im Netz direkt erreichbar sein: APP_BIND=0.0.0.0
APP_PORT=8787
APP_BIND=127.0.0.1

# Sicherung (Dienst „backup“, Ablage ./backups): alle BACKUP_INTERVALL_MINUTEN (nur wenn sich etwas geändert hat,
# sonst einmal täglich); die letzten 48 Stunden bleiben alle, danach eine je Tag bis BACKUP_TAGE.
# Platzbedarf: etwa 50 × Größe einer Sicherung (Großschau mit Belegen: 30–80 MB je Sicherung, also 2–4 GB).
BACKUP_INTERVALL_MINUTEN=120
BACKUP_TAGE=30
# Nur beim Selbstbau (scripts/docker-start.sh): so viel GB müssen vor einem Update frei sein, sonst räumt das Skript
# erst auf und bricht notfalls ab – eine volle Platte hält die Datenbank an. Leer = 5.
MIN_FREI_GB=
# Sicherungen werden verschlüsselt (age). Hier der ÖFFENTLICHE Schlüssel (beginnt mit age1…), mehrere mit Komma.
# Schlüsselpaar erzeugen auf einem eigenen Rechner (nicht dem Server):  age-keygen -o sicherung-schluessel.txt
# Die Datei enthält den PRIVATEN Schlüssel – in den Tresor (z. B. KeePass), danach löschen. Ohne ihn lässt sich keine
# Sicherung zurückspielen. Nur für Testinstallationen ohne echte Daten: BACKUP_UNVERSCHLUESSELT=1 statt eines Schlüssels.
BACKUP_EMPFAENGER=
# Nur Linux: Besitzer der Sicherungsdateien (sonst root, dann nur mit sudo zurückzuspielen). Werte aus `id -u` / `id -g`.
BACKUP_UID=
BACKUP_GID=

# Speichergrenze der Anwendung (docker-compose). 2g reicht auch für große Kataloge mit vielen Anzeigen.
APP_SPEICHER=2g

# Schlüssel für verschlüsselte Felder (IBAN, Kontoinhaber, SEPA-Dateien, Zwei-Faktor-Geheimnisse), 32 Byte Base64.
# Erzeugen:  openssl rand -base64 32   – und zusätzlich in den Tresor (KeePass): Geht er verloren, sind diese Felder
# nicht mehr lesbar (Sicherungen enthalten ihn nicht). Nie ändern, solange Daten damit verschlüsselt sind.
DATENSCHLUESSEL=

# Lesemodus (Entscheidung 025): NUR_LESEN=1 – SchauFUCHS nimmt keine Änderungen an, Ansehen, Drucken und Anmelden
# gehen weiter (z. B. während einer Wartung). Leer oder 0: normaler Betrieb. NUR_LESEN_HINWEIS erscheint dazu in der
# Leiste der Verwaltung (nicht für Aussteller und Preisrichter, nicht übersetzt), höchstens 300 Zeichen.
NUR_LESEN=
NUR_LESEN_HINWEIS=
